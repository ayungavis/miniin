[
  {
    "label": "SwiftBuild",
    "command": "make",
    "args": ["test", "lint"],
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "never",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
  },
  {
    "label": "SwiftRun",
    "command": "make",
    "args": ["ios-run"],
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
  },
  {
    "label": "SwiftLint",
    "command": "make",
    "args": ["lint"],
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
  },
  {
    "label": "SwiftValidate",
    "command": "make",
    "args": ["ios-validate"],
    "save": "all",
    "allow_concurrent_runs": false,
    "reveal": "always",
    "cwd": "$ZED_MAIN_GIT_WORKTREE",
  },
]
